---
// Reads the prediction:<sessionSlug> localStorage records
// src/components/PredictionCheck.astro already writes -- no reveal or
// answer state is touched here, only whether a prediction was committed.
import { getPublishedCollection } from "astro-course-university/content";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
const sessionData = visible.map((s) => ({ id: s.id, title: s.data.title, week: s.data.week }));
---

<div class="progress-dashboard" data-sessions={JSON.stringify(sessionData)}>
  <div class="progress-dashboard__summary" hidden>
    <p class="progress-dashboard__summary-text"></p>
    <div class="progress-dashboard__track">
      <div class="progress-dashboard__fill"></div>
    </div>
  </div>
  <ul class="progress-dashboard__grid" hidden></ul>
  <p class="progress-dashboard__unavailable" hidden>
    Prediction progress isn't available in this browser (private browsing or
    storage disabled). Your commitments still work normally on each
    workshop page — see the full list of {sessionData.length} workshops below.
  </p>
</div>

<style>
  .progress-dashboard__summary {
    margin-block-end: 1.25rem;
  }

  .progress-dashboard__summary-text {
    font-weight: 600;
    margin-block-end: 0.4rem;
  }

  /* .progress-dashboard__grid stays static (present in the template), so
     it keeps Astro's scoped styling; everything created client-side below
     (cards, the progress fill) must be :global -- otherwise the scoping
     attribute never lands on them and rules like height/width silently
     never apply. */
  .progress-dashboard__track {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--at-bg-alt);
    overflow: hidden;
  }

  :global(.progress-dashboard__fill) {
    height: 100%;
    border-radius: 999px;
    background: var(--at-accent);
    transition: width 0.2s ease;
  }

  .progress-dashboard__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.6rem;
    padding: 0;
    margin-block: 0 1.5rem;
    list-style: none;
  }

  :global(.progress-dashboard__card) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--at-bg-alt);
    background: var(--at-bg-alt);
  }

  :global(.progress-dashboard__card.is-committed) {
    border-color: var(--at-accent);
    background: color-mix(in srgb, var(--at-accent) 12%, transparent);
  }

  :global(.progress-dashboard__badge) {
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--at-bg);
    border: 1px solid var(--at-bg-alt);
  }

  :global(.progress-dashboard__card.is-committed .progress-dashboard__badge) {
    background: var(--at-accent);
    color: var(--at-bg);
    border-color: transparent;
  }

  :global(.progress-dashboard__label) {
    font-size: 0.8rem;
    line-height: 1.2;
    opacity: 0.9;
  }

  :global(.progress-dashboard__card.is-committed .progress-dashboard__label) {
    opacity: 1;
  }
</style>

<script>
  interface SessionSummary {
    id: string;
    title: string;
    week: number;
  }

  function initProgressDashboards() {
    for (const root of document.querySelectorAll<HTMLElement>(".progress-dashboard")) {
      if (root.dataset.initialised === "true") continue;
      root.dataset.initialised = "true";

      const summary = root.querySelector<HTMLElement>(".progress-dashboard__summary")!;
      const summaryText = root.querySelector<HTMLElement>(".progress-dashboard__summary-text")!;
      const fill = root.querySelector<HTMLElement>(".progress-dashboard__fill")!;
      const grid = root.querySelector<HTMLElement>(".progress-dashboard__grid")!;
      const unavailable = root.querySelector<HTMLElement>(".progress-dashboard__unavailable")!;

      let sessions: SessionSummary[] = [];
      try {
        sessions = JSON.parse(root.dataset.sessions!);
      } catch {
        continue;
      }

      let committedIds: Set<string>;
      try {
        committedIds = new Set(
          sessions.filter((s) => localStorage.getItem(`prediction:${s.id}`) !== null).map((s) => s.id),
        );
      } catch {
        unavailable.hidden = false;
        continue;
      }

      summary.hidden = false;
      summaryText.textContent = `${committedIds.size} of ${sessions.length} workshops: prediction committed.`;
      fill.style.width = `${sessions.length ? (committedIds.size / sessions.length) * 100 : 0}%`;

      grid.hidden = false;
      grid.replaceChildren(
        ...sessions.map((s) => {
          const committed = committedIds.has(s.id);

          const li = document.createElement("li");
          li.className = `progress-dashboard__card${committed ? " is-committed" : ""}`;

          const badge = document.createElement("span");
          badge.className = "progress-dashboard__badge";
          badge.textContent = committed ? "✓" : String(s.week);
          badge.setAttribute("aria-hidden", "true");

          const label = document.createElement("span");
          label.className = "progress-dashboard__label";
          label.textContent = `Week ${s.week}: ${s.title}`;

          li.append(badge, label);
          return li;
        }),
      );
    }
  }

  document.addEventListener("astro:page-load", initProgressDashboards);
  initProgressDashboards();
</script>
