---
import Callout from "astro-theme-university/components/Callout.astro";

export interface Props {
  /** Unique per-session key for the localStorage record. */
  sessionSlug: string;
}

const { sessionSlug } = Astro.props;
const storageKey = `check:${sessionSlug}`;
---

<Callout type="tip">
  <div class="five-minute-check" data-storage-key={storageKey}>
    <label class="five-minute-check__label" for={`five-minute-check-input-${sessionSlug}`}>
      Your answer
    </label>
    <textarea
      id={`five-minute-check-input-${sessionSlug}`}
      class="five-minute-check__input"
      rows="3"
      placeholder="Write your answer here, then submit."
    ></textarea>
    <div class="five-minute-check__controls">
      <button type="button" class="five-minute-check__submit">Submit answer</button>
      <button type="button" class="five-minute-check__edit" hidden>Edit my answer</button>
    </div>
    <p class="five-minute-check__submitted-at" hidden></p>
    <div class="five-minute-check__answer" hidden>
      <p class="five-minute-check__answer-label"><strong>Indicative answer</strong></p>
      <slot />
    </div>
  </div>
</Callout>

<style>
  .five-minute-check__label {
    display: block;
    font-weight: 600;
    margin-block-end: 0.35rem;
  }

  .five-minute-check__input {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 1rem;
    margin-block-end: 0.5rem;
  }

  .five-minute-check__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .five-minute-check__submitted-at {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .five-minute-check__answer {
    margin-block-start: 1rem;
    padding-block-start: 0.75rem;
    border-top: 1px solid var(--at-border, #ccc);
  }

  .five-minute-check__answer-label {
    margin-block-end: 0.35rem;
  }
</style>

<script>
  function initFiveMinuteChecks() {
    for (const root of document.querySelectorAll<HTMLElement>(".five-minute-check")) {
      if (root.dataset.initialised === "true") continue;
      root.dataset.initialised = "true";

      const storageKey = root.dataset.storageKey!;
      const input = root.querySelector<HTMLTextAreaElement>(".five-minute-check__input")!;
      const submitButton = root.querySelector<HTMLButtonElement>(".five-minute-check__submit")!;
      const editButton = root.querySelector<HTMLButtonElement>(".five-minute-check__edit")!;
      const submittedAt = root.querySelector<HTMLElement>(".five-minute-check__submitted-at")!;
      const answer = root.querySelector<HTMLElement>(".five-minute-check__answer")!;

      function renderSubmitted(text: string, at: string) {
        input.value = text;
        input.disabled = true;
        submitButton.hidden = true;
        editButton.hidden = false;
        submittedAt.hidden = false;
        submittedAt.textContent = `Submitted ${new Date(at).toLocaleString()}.`;
        answer.hidden = false;
      }

      function renderUnsubmitted() {
        input.disabled = false;
        submitButton.hidden = false;
        editButton.hidden = true;
        submittedAt.hidden = true;
        answer.hidden = true;
      }

      let saved: { text: string; submittedAt: string } | null = null;
      try {
        const raw = localStorage.getItem(storageKey);
        saved = raw ? JSON.parse(raw) : null;
      } catch {
        saved = null;
      }
      if (saved) {
        renderSubmitted(saved.text, saved.submittedAt);
      }

      submitButton.addEventListener("click", () => {
        const text = input.value.trim();
        if (!text) return;
        const record = { text, submittedAt: new Date().toISOString() };
        try {
          localStorage.setItem(storageKey, JSON.stringify(record));
        } catch {
          // Private browsing or a full quota — the submission still applies
          // for this page view even if it won't persist across a reload.
        }
        renderSubmitted(record.text, record.submittedAt);
      });

      editButton.addEventListener("click", () => {
        input.disabled = false;
        input.focus();
        renderUnsubmitted();
      });
    }
  }

  document.addEventListener("astro:page-load", initFiveMinuteChecks);
  initFiveMinuteChecks();
</script>
