---
// Applies week 1's own counting rule (packs/week-01/build.ts) to arbitrary
// text, live, in the browser. Each generation corrupts the PREVIOUS
// generation's output, not the original -- that compounding is what
// "generation loss" means. Math.random() drives the corruption, so the
// counting step stays a deterministic function of two strings while the
// strings themselves differ run to run -- the same distinction week 1's
// worked answer draws between the algorithm and the world it measures.
export interface Props {
  /** Seed sample text shown in the textarea on first load. */
  sampleText?: string;
  /** Default number of generations (slider default). */
  defaultGenerations?: number;
  /** Default per-generation error rate, 1-20 (percent). */
  defaultErrorRate?: number;
  /**
   * Workshop-specific seed text, keyed by session slug. When the page loads
   * with a `?from=<slug>` query param matching a key here, that text
   * replaces `sampleText` on first render -- lets a workshop page link in
   * with its own example already loaded, instead of a generic default.
   */
  presets?: Record<string, string>;
}

const {
  sampleText = "The quick brown fox jumps over the lazy dog. 0O1lI5S8B2Z6G9g",
  defaultGenerations = 8,
  defaultErrorRate = 6,
  presets,
} = Astro.props;
---

<div
  class="gls"
  data-sample-text={sampleText}
  data-default-generations={defaultGenerations}
  data-default-error-rate={defaultErrorRate}
  data-confusable-chars="0O 1lI 5S 8B 2Z 6G 9g"
  data-presets={presets ? JSON.stringify(presets) : undefined}
>
  <label class="gls__field">
    Text to copy
    <textarea class="gls__input" rows="3">{sampleText}</textarea>
  </label>

  <fieldset class="gls__model">
    <legend>Corruption model</legend>
    <p class="gls__caption">
      A copier's error either follows the world's own randomness, or it
      follows a fixed rule — the same distinction week 1's worked answer
      draws between the algorithm and the world it measures. Switch
      between them on the same text to see how differently each one
      degrades it.
    </p>
    <label class="gls__radio">
      <input type="radio" name="gls__model-choice" class="gls__model-random" value="random" checked />
      Random (rate-based) — each character has an independent chance of damage
    </label>
    <label class="gls__radio">
      <input type="radio" name="gls__model-choice" class="gls__model-fixed" value="fixed" />
      Fixed rule (every Nth character) — no randomness at all
    </label>
  </fieldset>

  <div class="gls__controls">
    <label class="gls__field">
      Generations: <output class="gls__generations-value">{defaultGenerations}</output>
      <input type="range" class="gls__generations" min="0" max="20" step="1" value={defaultGenerations} />
    </label>
    <label class="gls__field gls__rate-field">
      Error rate per generation: <output class="gls__rate-value">{defaultErrorRate}%</output>
      <input type="range" class="gls__rate" min="1" max="20" step="1" value={defaultErrorRate} />
    </label>
    <label class="gls__field gls__n-field" hidden>
      Corrupt every Nth character: <output class="gls__n-value">5</output>
      <input type="range" class="gls__n" min="2" max="20" step="1" value="5" />
    </label>
    <button type="button" class="gls__reroll">Re-roll (same settings, new randomness)</button>
  </div>

  <div class="gls__output">
    {/* A one-line spoken summary. Putting aria-live on the whole output block
        instead would read the entire degraded passage aloud on every keystroke. */}
    <p class="gls__status visually-hidden" aria-live="polite"></p>
    <h2 class="gls__result-heading">Generation {defaultGenerations} output</h2>
    <pre class="gls__result-text"></pre>

    <h2>Cumulative error, by generation</h2>
    <p class="gls__caption">
      <strong>G0</strong> is your original text, uncopied. <strong>G1</strong>
      is one copy of it, <strong>G2</strong> a copy of that copy, and so on —
      each bar is the percentage of characters that now differ from G0.
    </p>
    <div class="gls__bars" role="img" aria-label="Cumulative error percentage per generation"></div>
    <ul class="gls__bars-fallback visually-hidden"></ul>

    <h2>Which confusable characters this run affected</h2>
    <p class="gls__caption gls__confusable-caption">
      Week 1's card was built from characters that look like one another —{" "}
      <code>0O</code>, <code>1lI</code>, <code>5S</code>, <code>8B</code>,{" "}
      <code>2Z</code>, <code>6G</code>, <code>9g</code>. Each bar is how many
      times a character from that group was misread or went illegible in
      this run.
    </p>
    <div class="gls__bars gls__confusable-bars" role="img" aria-label="Misreadings and illegibles per confusable group"></div>
    <ul class="gls__bars-fallback gls__confusable-bars-fallback visually-hidden"></ul>
    <p class="gls__confusable-empty" hidden>
      None of this text's characters belong to week 1's confusable set, so
      there is nothing to break down here — try the sample text above.
    </p>

    <h2>Count (final generation vs. original)</h2>
    <p class="gls__caption">
      A <strong>misreading</strong> is a character swapped for a different
      one (like <code>0</code> becoming <code>O</code>); an
      <strong>illegible</strong> is a character replaced with{" "}
      <code>·</code> because it could no longer be resolved at all.
    </p>
    <dl class="gls__stats">
      <dt>Misreadings</dt>
      <dd class="gls__stat-misreadings"></dd>
      <dt>Illegibles</dt>
      <dd class="gls__stat-illegibles"></dd>
      <dt>Total</dt>
      <dd class="gls__stat-total"></dd>
    </dl>
  </div>
</div>

<style>
  .gls__field {
    display: block;
    margin-block: 0.75rem;
  }

  .gls__input {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 1rem;
    margin-block-start: 0.3rem;
  }

  .gls__model {
    margin-block: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 0.5rem;
  }

  .gls__radio {
    display: block;
    font-size: 0.9rem;
    margin-block: 0.3rem;
  }

  .gls__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .gls__controls input[type="range"] {
    width: 100%;
  }

  .gls__caption {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-block: 0.25rem 0.75rem;
  }

  .gls__result-text {
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 1.1rem;
  }

  .gls__bars {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Bar rows are created client-side via document.createElement, so they
     never receive Astro's scoping attribute -- these rules must be :global
     or they silently never match, and the bars render at zero height. */
  :global(.gls__bar-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.gls__bar-label) {
    flex: 0 0 2.5rem;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  :global(.gls__bar-track) {
    flex: 1 1 auto;
    background: var(--at-bg-alt);
    border-radius: 4px;
    overflow: hidden;
    height: 0.75rem;
  }

  :global(.gls__bar-fill) {
    height: 100%;
    background: var(--at-text-secondary);
  }

  .gls__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .gls__stats dt {
    font-weight: 600;
  }

  .gls__stats dd {
    margin: 0;
  }
</style>

<script>
  function initGenerationLossSimulators() {
    for (const root of document.querySelectorAll<HTMLElement>(".gls")) {
      if (root.dataset.initialised === "true") continue;
      root.dataset.initialised = "true";

      const ILLEGIBLE = "·";
      const confusableGroups = root.dataset.confusableChars!.split(" ").map((g) => g.split(""));
      const confusableMap = new Map<string, string[]>();
      const confusableGroupLabel = new Map<string, string>();
      for (const group of confusableGroups) {
        const label = group.join("");
        for (const ch of group) {
          confusableMap.set(ch, group.filter((c) => c !== ch));
          confusableGroupLabel.set(ch, label);
        }
      }

      const input = root.querySelector<HTMLTextAreaElement>(".gls__input")!;
      const generationsSlider = root.querySelector<HTMLInputElement>(".gls__generations")!;
      const rateSlider = root.querySelector<HTMLInputElement>(".gls__rate")!;
      const nSlider = root.querySelector<HTMLInputElement>(".gls__n")!;
      const generationsValue = root.querySelector<HTMLElement>(".gls__generations-value")!;
      const rateValue = root.querySelector<HTMLElement>(".gls__rate-value")!;
      const nValue = root.querySelector<HTMLElement>(".gls__n-value")!;
      const rateField = root.querySelector<HTMLElement>(".gls__rate-field")!;
      const nField = root.querySelector<HTMLElement>(".gls__n-field")!;
      const modelRandom = root.querySelector<HTMLInputElement>(".gls__model-random")!;
      const modelFixed = root.querySelector<HTMLInputElement>(".gls__model-fixed")!;
      const rerollButton = root.querySelector<HTMLButtonElement>(".gls__reroll")!;
      const resultHeading = root.querySelector<HTMLElement>(".gls__result-heading")!;
      const resultText = root.querySelector<HTMLElement>(".gls__result-text")!;
      const status = root.querySelector<HTMLElement>(".gls__status")!;
      const barsContainer = root.querySelector<HTMLElement>(".gls__bars:not(.gls__confusable-bars)")!;
      const barsFallback = root.querySelector<HTMLElement>(".gls__bars-fallback:not(.gls__confusable-bars-fallback)")!;
      const confusableCaption = root.querySelector<HTMLElement>(".gls__confusable-caption")!;
      const confusableBars = root.querySelector<HTMLElement>(".gls__confusable-bars")!;
      const confusableBarsFallback = root.querySelector<HTMLElement>(".gls__confusable-bars-fallback")!;
      const confusableEmpty = root.querySelector<HTMLElement>(".gls__confusable-empty")!;
      const statMisreadings = root.querySelector<HTMLElement>(".gls__stat-misreadings")!;
      const statIllegibles = root.querySelector<HTMLElement>(".gls__stat-illegibles")!;
      const statTotal = root.querySelector<HTMLElement>(".gls__stat-total")!;

      // One generation: copy `text`, corrupting each character with
      // probability `rate`. Substitution only -- length never changes, so a
      // later diff against the original stays a valid position-by-position
      // comparison (countErrors below requires equal lengths, exactly like
      // packs/week-01/build.ts).
      function degradeOnce(text: string, rate: number): string {
        let out = "";
        for (const ch of text) {
          if (Math.random() < rate) {
            const neighbours = confusableMap.get(ch.toUpperCase());
            if (neighbours && neighbours.length && Math.random() < 0.7) {
              const pick = neighbours[Math.floor(Math.random() * neighbours.length)];
              out += ch === ch.toUpperCase() ? pick : pick.toLowerCase();
            } else if (/[a-zA-Z0-9]/.test(ch)) {
              out += ILLEGIBLE;
            } else {
              out += ch;
            }
          } else {
            out += ch;
          }
        }
        return out;
      }

      // The fixed-rule counterpart to degradeOnce: no Math.random() at all.
      // Every character at a position that is a multiple of `n` is
      // corrupted, always with the SAME neighbour (the first one listed for
      // its confusable group) or ILLEGIBLE if it has none -- the same input
      // and the same n always produce the same output, dramatizing the
      // algorithm-vs-world distinction as something you can switch between
      // rather than only read about.
      function degradeOnceFixed(text: string, n: number): string {
        let out = "";
        let position = 0;
        for (const ch of text) {
          position++;
          if (position % n === 0) {
            const neighbours = confusableMap.get(ch.toUpperCase());
            if (neighbours && neighbours.length) {
              const pick = neighbours[0];
              out += ch === ch.toUpperCase() ? pick : pick.toLowerCase();
            } else if (/[a-zA-Z0-9]/.test(ch)) {
              out += ILLEGIBLE;
            } else {
              out += ch;
            }
          } else {
            out += ch;
          }
        }
        return out;
      }

      // Each step corrupts the PREVIOUS output, not the original -- true
      // compounding generation loss, not independent per-generation noise.
      function runChain(
        original: string,
        generations: number,
        ratePercent: number,
        model: "random" | "fixed",
        n: number,
      ): string[] {
        const rate = ratePercent / 100;
        const history = [original];
        let current = original;
        for (let g = 1; g <= generations; g++) {
          current = model === "fixed" ? degradeOnceFixed(current, n) : degradeOnce(current, rate);
          history.push(current);
        }
        return history;
      }

      // Exact port of packs/week-01/build.ts's countErrors: position-by-
      // position diff of two equal-length strings, split into misreadings
      // (any other mismatch) and illegibles (the ILLEGIBLE marker).
      function countErrors(original: string, finalText: string) {
        if (original.length !== finalText.length) {
          throw new Error("lengths differ, rule cannot apply");
        }
        let misreadings = 0;
        let illegibles = 0;
        for (let i = 0; i < original.length; i++) {
          if (original[i] === finalText[i]) continue;
          if (finalText[i] === ILLEGIBLE) illegibles++;
          else misreadings++;
        }
        return { misreadings, illegibles, total: misreadings + illegibles };
      }

      // Tally each mismatched position by which confusable group the
      // ORIGINAL character belonged to (not the corrupted character it
      // became) -- this answers "which of week 1's confusable groups did
      // this run's damage land on", not "what did it turn into".
      function confusableTally(original: string, finalText: string): Map<string, number> {
        const tally = new Map<string, number>();
        for (let i = 0; i < original.length; i++) {
          if (original[i] === finalText[i]) continue;
          const label = confusableGroupLabel.get(original[i].toUpperCase());
          if (!label) continue;
          tally.set(label, (tally.get(label) ?? 0) + 1);
        }
        return tally;
      }

      function cumulativeErrorSeries(original: string, history: string[]): number[] {
        return history.map((text) => {
          if (!original.length) return 0;
          const { total } = countErrors(original, text);
          return (total / original.length) * 100;
        });
      }

      function render() {
        const original = input.value;
        const generations = Number(generationsSlider.value);
        const ratePercent = Number(rateSlider.value);
        const n = Number(nSlider.value);
        const model: "random" | "fixed" = modelFixed.checked ? "fixed" : "random";
        generationsValue.textContent = String(generations);
        rateValue.textContent = `${ratePercent}%`;
        nValue.textContent = String(n);
        rateField.hidden = model === "fixed";
        nField.hidden = model === "random";
        rerollButton.disabled = model === "fixed";
        rerollButton.title = model === "fixed" ? "The fixed rule has no randomness to re-roll." : "";

        const history = runChain(original, generations, ratePercent, model, n);
        const final = history[history.length - 1];
        const series = cumulativeErrorSeries(original, history);

        resultHeading.textContent = `Generation ${generations} output`;
        resultText.textContent = final;

        barsContainer.replaceChildren();
        barsFallback.replaceChildren();
        series.forEach((pct, g) => {
          const row = document.createElement("div");
          row.className = "gls__bar-row";
          const label = document.createElement("span");
          label.className = "gls__bar-label";
          label.textContent = `G${g}`;
          const track = document.createElement("div");
          track.className = "gls__bar-track";
          const fill = document.createElement("div");
          fill.className = "gls__bar-fill";
          fill.style.width = `${Math.min(100, pct).toFixed(1)}%`;
          track.appendChild(fill);
          row.append(label, track);
          barsContainer.appendChild(row);

          const li = document.createElement("li");
          li.textContent = `Generation ${g}: ${pct.toFixed(1)}% cumulative error`;
          barsFallback.appendChild(li);
        });

        confusableBars.replaceChildren();
        confusableBarsFallback.replaceChildren();
        if (!original.length) {
          statMisreadings.textContent = "0";
          statIllegibles.textContent = "0";
          statTotal.textContent = "0";
          confusableCaption.hidden = true;
          confusableEmpty.hidden = true;
          status.textContent = "No text to copy yet — type something to start a chain.";
          return;
        }
        const { misreadings, illegibles, total } = countErrors(original, final);
        statMisreadings.textContent = String(misreadings);
        statIllegibles.textContent = String(illegibles);
        statTotal.textContent = String(total);
        status.textContent =
          `Generation ${generations}: ${misreadings} misreadings, ${illegibles} illegibles, ` +
          `${total} of ${original.length} characters changed.`;

        const tally = confusableTally(original, final);
        const entries = [...tally.entries()].sort((a, b) => b[1] - a[1]);
        confusableCaption.hidden = entries.length === 0;
        confusableEmpty.hidden = entries.length !== 0;
        const maxCount = entries.length ? entries[0][1] : 0;
        for (const [label, count] of entries) {
          const row = document.createElement("div");
          row.className = "gls__bar-row";
          const barLabel = document.createElement("span");
          barLabel.className = "gls__bar-label";
          barLabel.textContent = label;
          const track = document.createElement("div");
          track.className = "gls__bar-track";
          const fill = document.createElement("div");
          fill.className = "gls__bar-fill";
          fill.style.width = `${((count / maxCount) * 100).toFixed(1)}%`;
          track.appendChild(fill);
          row.append(barLabel, track);
          confusableBars.appendChild(row);

          const li = document.createElement("li");
          li.textContent = `${label}: ${count} misreading${count === 1 ? "" : "s"} or illegibles`;
          confusableBarsFallback.appendChild(li);
        }
      }

      input.addEventListener("input", render);
      generationsSlider.addEventListener("input", render);
      rateSlider.addEventListener("input", render);
      nSlider.addEventListener("input", render);
      modelRandom.addEventListener("change", render);
      modelFixed.addEventListener("change", render);
      rerollButton.addEventListener("click", render);

      // A workshop page can link in as e.g. /simulator/?from=06-stemma so
      // this loads with that week's own example already in the textarea,
      // instead of the generic default -- best-effort, silently ignored if
      // `from` doesn't match a preset this instance was given.
      try {
        const presets: Record<string, string> = root.dataset.presets ? JSON.parse(root.dataset.presets) : {};
        const from = new URLSearchParams(window.location.search).get("from");
        if (from && presets[from]) {
          input.value = presets[from];
        }
      } catch {
        // Malformed presets or an unavailable URLSearchParams: fall back
        // to the sample text already in the textarea.
      }

      render();
    }
  }

  document.addEventListener("astro:page-load", initGenerationLossSimulators);
  initGenerationLossSimulators();
</script>
