---
// Ports the SHAPE of week 9's categorical resampling model
// (packs/week-09/build.ts) client-side, as an illustrative analogy --
// not the pack's own model.json data or its seeded mulberry32 PRNG, since
// that is the actual assessed dataset. This tool uses an editable,
// generic category distribution and Math.random(), so it can build
// intuition for what re-estimating a sampling distribution from a prior
// sample does over many rounds, without reproducing the graded artifact.
export interface Props {
  /** "label:weight" pairs, comma-separated. Weights need not sum to 100 -- they are normalised. */
  defaultCategories?: string;
  /** Default number of resampling rounds after round 0. */
  defaultRounds?: number;
  /** Samples drawn per round. Fixed, not user-editable, to keep the control surface small. */
  roundSize?: number;
}

const {
  defaultCategories = "A:30,B:25,C:20,D:15,E:7,F:3",
  defaultRounds = 5,
  roundSize = 200,
} = Astro.props;
---

<div
  class="rs"
  data-default-categories={defaultCategories}
  data-default-rounds={defaultRounds}
  data-round-size={roundSize}
>
  <p class="rs__pitch">
    Every round below draws {roundSize} samples, like drawing {roundSize}
    marbles from a jar. The question this toy asks is simple:{" "}
    <strong>does each round check the real jar, or does it just trust the
    last handful it drew?</strong> If a round only trusts the last handful,
    and that handful happened to be a bit short on one colour, the next
    round assumes that colour is rarer than it really is — and draws even
    less of it. Do that enough times and a colour that was always in the
    jar can vanish from your guesses completely, even though it never left
    the real jar.
  </p>

  <p class="rs__example">
    <strong>A concrete example:</strong> say 5% of your customers really do
    order decaf coffee. One week, by pure chance, your small sample of
    orders only has 3% decaf. If next week's ordering guess is built only
    from that one sample (no re-checking with real customers), you'll
    stock even less decaf. That makes next week's sample even lower —
    maybe 1%. Repeat this for a few weeks and your system can end up
    "deciding" nobody orders decaf, even though 5% of customers always
    did. This is the same problem behind{" "}
    <strong>"model collapse"</strong>: an AI that keeps training on its
    own past guesses, instead of real data, can quietly forget the rare
    things it once knew — try the "Fully recursive" option below to watch
    it happen.
  </p>

  <div class="rs__layout">
    <div class="rs__panel rs__panel--setup">
      <h3 class="rs__panel-title">1. Set up the world</h3>
      <label class="rs__field">
        What's in the jar? (write it as label:weight, comma-separated —
        e.g. "Cats:70,Dogs:25,Birds:5")
        <input type="text" class="rs__categories" value={defaultCategories} />
      </label>

      <fieldset class="rs__model">
        <legend>2. Pick how each round re-estimates</legend>
        <label class="rs__option">
          <input type="radio" name="rs__condition" class="rs__condition-baseline" value="baseline" checked />
          <span class="rs__option-body">
            <strong>Baseline</strong>
            <span class="rs__option-desc">Every round checks the real jar directly, like re-polling actual customers each time. Nothing from a past round ever carries forward, so there is nothing to pile up.</span>
          </span>
        </label>
        <label class="rs__option">
          <input type="radio" name="rs__condition" class="rs__condition-full" value="full-recursive" />
          <span class="rs__option-body">
            <strong>Fully recursive</strong>
            <span class="rs__option-desc">Each round only looks at what the last round drew — like a photocopy of a photocopy. It never checks the real jar again, so any small mistake gets copied forward and can grow.</span>
          </span>
        </label>
        <label class="rs__option">
          <input type="radio" name="rs__condition" class="rs__condition-retained" value="retained-mix" />
          <span class="rs__option-body">
            <strong>Retained mix</strong>
            <span class="rs__option-desc">Each round takes what the last round drew, then also takes one fresh peek at the real jar. Reality gets a say every time, so it cannot drift as far.</span>
          </span>
        </label>
        <p class="rs__caption">Round 0 always checks the real jar in every mode — the three modes only start behaving differently from round 1 onwards.</p>
      </fieldset>

      <div class="rs__controls">
        <label class="rs__field">
          Rounds: <output class="rs__rounds-value">{defaultRounds}</output>
          <input type="range" class="rs__rounds" min="2" max="10" step="1" value={defaultRounds} />
        </label>
        <button type="button" class="rs__reroll">🎲 Re-roll (same settings, new randomness)</button>
      </div>
    </div>

    <div class="rs__panel rs__panel--results">
      <h3 class="rs__panel-title">3. Watch the rarest category</h3>
      <p class="rs__takeaway"></p>

      <div class="rs__watch">
        <p class="rs__caption rs__rare-caption"></p>
        <div class="rs__trend" role="img" aria-label="Rarest category's share of the sample, per round"></div>
        <ul class="rs__trend-fallback visually-hidden"></ul>
      </div>

      <details class="rs__detail" open>
        <summary>Full distribution, round by round</summary>
        <p class="rs__caption">
          Think of each row as a jar of {roundSize} marbles for that round —
          every coloured stripe is one category's share of that round's
          draws. This is not week 9's own dataset or seeds. Changing the
          mode above doesn't redraw on its own; press "Re-roll" to draw a
          fresh set.
        </p>
        <ul class="rs__legend"></ul>
        <div class="rs__stacks"></div>
        <div class="rs__table-wrap">
          <table class="rs__table">
            <thead>
              <tr class="rs__table-head"></tr>
            </thead>
            <tbody class="rs__table-body"></tbody>
          </table>
        </div>
      </details>
    </div>
  </div>
</div>

<style>
  .rs__pitch {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
    padding: 0.9rem 1.1rem;
    border-inline-start: 4px solid var(--at-accent);
    background: var(--at-bg-alt);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .rs__example {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1.1rem;
    background: var(--at-bg-alt);
    border: 1px dashed var(--at-border, #ccc);
    border-radius: 0.5rem;
  }

  .rs__layout {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) minmax(20rem, 1.6fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 55rem) {
    .rs__layout {
      grid-template-columns: 1fr;
    }
  }

  .rs__panel {
    padding: 1rem 1.1rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 0.75rem;
  }

  .rs__panel--setup {
    background: var(--at-bg-alt);
  }

  .rs__panel-title {
    margin-block: 0 0.75rem;
    font-size: 1rem;
  }

  .rs__field {
    display: block;
    margin-block: 0.75rem;
  }

  .rs__categories {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 1rem;
    margin-block-start: 0.3rem;
  }

  .rs__model {
    margin-block: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 0.5rem;
  }

  .rs__option {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.5rem;
    margin-block: 0.3rem;
    border-radius: 0.4rem;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .rs__option:has(input:checked) {
    border-color: var(--at-accent);
    background: var(--at-bg);
  }

  .rs__option input {
    margin-block-start: 0.3rem;
  }

  .rs__option-body {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .rs__option-desc {
    font-size: 0.82rem;
    opacity: 0.75;
  }

  .rs__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .rs__controls input[type="range"] {
    width: 100%;
  }

  .rs__reroll {
    font-size: 0.95rem;
  }

  .rs__caption {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-block: 0.25rem 0.75rem;
  }

  .rs__takeaway {
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--at-bg-alt);
    border: 1px dashed var(--at-accent);
    margin-block: 0 1rem;
  }

  .rs__watch {
    margin-block-end: 1rem;
  }

  .rs__detail summary {
    cursor: pointer;
    font-weight: 700;
    margin-block-end: 0.5rem;
  }

  /* Bar rows, stacked-bar segments and table rows are created client-side
     via document.createElement, so they never receive Astro's scoping
     attribute -- these rules must be :global or they silently never
     match, and the visuals render at zero size (see
     GenerationLossSimulator.astro, which hit this same bug first). */
  :global(.rs__trend-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.15rem;
  }

  :global(.rs__trend-label) {
    flex: 0 0 3rem;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  :global(.rs__trend-track) {
    flex: 1 1 auto;
    background: var(--at-bg-alt);
    border-radius: 4px;
    overflow: hidden;
    height: 0.9rem;
    position: relative;
  }

  :global(.rs__trend-fill) {
    height: 100%;
    background: var(--at-accent);
    transition: width 0.2s ease;
  }

  :global(.rs__trend-truth) {
    position: absolute;
    inset-block: 0;
    width: 2px;
    background: var(--at-text-secondary);
  }

  .rs__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    font-size: 0.82rem;
  }

  :global(.rs__legend-item) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global(.rs__legend-swatch) {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 0.2rem;
  }

  .rs__stacks {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-block-end: 1rem;
  }

  :global(.rs__stack-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.rs__stack-label) {
    flex: 0 0 3rem;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  :global(.rs__stack-track) {
    flex: 1 1 auto;
    display: flex;
    height: 1.3rem;
    border-radius: 0.3rem;
    overflow: hidden;
    border: 1px solid var(--at-border, #ccc);
  }

  :global(.rs__stack-segment) {
    height: 100%;
    min-width: 2px;
  }

  .rs__table-wrap {
    overflow-x: auto;
  }

  :global(.rs__table) {
    border-collapse: collapse;
    font-size: 0.85rem;
    width: 100%;
  }

  :global(.rs__table th),
  :global(.rs__table td) {
    border: 1px solid var(--at-border, #ccc);
    padding: 0.3rem 0.5rem;
    text-align: right;
  }

  :global(.rs__table th:first-child),
  :global(.rs__table td:first-child) {
    text-align: left;
  }
</style>

<script>
  function initResamplingSimulators() {
    for (const root of document.querySelectorAll<HTMLElement>(".rs")) {
      if (root.dataset.initialised === "true") continue;
      root.dataset.initialised = "true";

      const roundSize = Number(root.dataset.roundSize);

      const categoriesInput = root.querySelector<HTMLInputElement>(".rs__categories")!;
      const roundsSlider = root.querySelector<HTMLInputElement>(".rs__rounds")!;
      const roundsValue = root.querySelector<HTMLElement>(".rs__rounds-value")!;
      const conditionBaseline = root.querySelector<HTMLInputElement>(".rs__condition-baseline")!;
      const conditionFull = root.querySelector<HTMLInputElement>(".rs__condition-full")!;
      const conditionRetained = root.querySelector<HTMLInputElement>(".rs__condition-retained")!;
      const rerollButton = root.querySelector<HTMLButtonElement>(".rs__reroll")!;
      const takeaway = root.querySelector<HTMLElement>(".rs__takeaway")!;
      const rareCaption = root.querySelector<HTMLElement>(".rs__rare-caption")!;
      const trendContainer = root.querySelector<HTMLElement>(".rs__trend")!;
      const trendFallback = root.querySelector<HTMLElement>(".rs__trend-fallback")!;
      const legend = root.querySelector<HTMLElement>(".rs__legend")!;
      const stacks = root.querySelector<HTMLElement>(".rs__stacks")!;
      const tableHead = root.querySelector<HTMLElement>(".rs__table-head")!;
      const tableBody = root.querySelector<HTMLElement>(".rs__table-body")!;

      // "label:weight,label:weight" -> normalised probability vector.
      // Malformed entries (no ":", non-numeric weight, weight <= 0) are
      // dropped rather than crashing the tool on a typo mid-edit.
      function parseCategories(spec: string): { labels: string[]; probs: number[] } {
        const labels: string[] = [];
        const weights: number[] = [];
        for (const part of spec.split(",")) {
          const [label, weightRaw] = part.split(":").map((s) => s.trim());
          const weight = Number(weightRaw);
          if (!label || !Number.isFinite(weight) || weight <= 0) continue;
          labels.push(label);
          weights.push(weight);
        }
        const total = weights.reduce((a, b) => a + b, 0);
        const probs = total > 0 ? weights.map((w) => w / total) : weights.map(() => 0);
        return { labels, probs };
      }

      // Categorical sample of size n from a probability vector, via
      // Math.random() -- deliberately not the pack's seeded mulberry32,
      // since this tool is a generic illustration, not a graded artifact.
      function draw(labels: string[], probs: number[], n: number): string[] {
        const cum: number[] = [];
        probs.reduce((acc, p, i) => (cum[i] = acc + p), 0);
        const out: string[] = [];
        for (let i = 0; i < n; i++) {
          const r = Math.random();
          let idx = cum.findIndex((c) => r < c);
          if (idx === -1) idx = labels.length - 1;
          out.push(labels[idx]);
        }
        return out;
      }

      function counts(labels: string[], sample: string[]): number[] {
        return labels.map((label) => sample.filter((s) => s === label).length);
      }

      function normalise(freqs: number[]): number[] {
        const total = freqs.reduce((a, b) => a + b, 0);
        return total === 0 ? freqs.map(() => 0) : freqs.map((f) => f / total);
      }

      // Same three-condition shape as packs/week-09/build.ts's
      // simulateRun: baseline always redraws from the true distribution;
      // full-recursive re-estimates entirely from the previous round's own
      // sample; retained-mix blends the previous sample with a fresh
      // true-distribution draw before re-estimating.
      function simulateRun(
        labels: string[],
        trueProbs: number[],
        condition: "baseline" | "full-recursive" | "retained-mix",
        rounds: number,
      ): string[][] {
        const samples: string[][] = [draw(labels, trueProbs, roundSize)];
        for (let r = 1; r <= rounds; r++) {
          const prev = samples[r - 1];
          let probs: number[];
          if (condition === "baseline") {
            probs = trueProbs;
          } else if (condition === "full-recursive") {
            probs = normalise(counts(labels, prev));
          } else {
            const fresh = draw(labels, trueProbs, roundSize);
            const prevCounts = counts(labels, prev);
            const freshCounts = counts(labels, fresh);
            probs = normalise(prevCounts.map((c, i) => c + freshCounts[i]));
          }
          samples.push(draw(labels, probs, roundSize));
        }
        return samples;
      }

      // Deterministic hue per category index, so the legend/stacked-bar
      // colours stay stable as long as the category order doesn't change,
      // without hard-coding a fixed palette size.
      function colourFor(index: number, total: number): string {
        const hue = Math.round((360 / Math.max(total, 1)) * index);
        return `hsl(${hue}, 55%, 50%)`;
      }

      function writeTakeaway(
        condition: "baseline" | "full-recursive" | "retained-mix",
        rareLabel: string,
        trueRarePct: number,
        round0Pct: number,
        finalPct: number,
        finalCount: number,
        rounds: number,
      ) {
        if (condition === "baseline") {
          takeaway.textContent = `Baseline keeps checking the real jar every round, so "${rareLabel}" stays close to its real ${trueRarePct.toFixed(1)}% no matter how many rounds pass: it was ${round0Pct.toFixed(1)}% in round 0 and still ${finalPct.toFixed(1)}% by round ${rounds}. Nothing here compounds, because nothing carries over from one round to the next.`;
        } else if (condition === "full-recursive") {
          takeaway.textContent = `Fully recursive never checks the real jar again after round 0 — each round only trusts what the last round drew. "${rareLabel}" started at ${round0Pct.toFixed(1)}% in round 0 (drawn from its real ${trueRarePct.toFixed(1)}%), and by round ${rounds} it had dropped to ${finalPct.toFixed(1)}%${finalCount === 0 ? " — it has completely disappeared from the sample, and once that happens here it can never be drawn again" : ", drifting further away every round"}. This is the same problem as "model collapse": an AI that keeps learning from its own past outputs, instead of real data, can quietly forget rare things it once knew.`;
        } else {
          takeaway.textContent = `Retained mix takes a fresh peek at the real jar every round too, so the drift is much gentler. "${rareLabel}" moved from ${round0Pct.toFixed(1)}% (round 0) to ${finalPct.toFixed(1)}% (round ${rounds}) — its real share is ${trueRarePct.toFixed(1)}%. It's not as steady as baseline, but nowhere near as risky as fully recursive, because reality still gets a vote each round.`;
        }
      }

      function render() {
        const { labels, probs } = parseCategories(categoriesInput.value);
        const rounds = Number(roundsSlider.value);
        roundsValue.textContent = String(rounds);

        trendContainer.replaceChildren();
        trendFallback.replaceChildren();
        legend.replaceChildren();
        stacks.replaceChildren();
        tableHead.replaceChildren();
        tableBody.replaceChildren();

        if (!labels.length) {
          rareCaption.textContent = "Add at least one valid label:weight pair to run this.";
          takeaway.textContent = "";
          return;
        }

        const rareIndex = probs.indexOf(Math.min(...probs));
        const rareLabel = labels[rareIndex];
        const condition: "baseline" | "full-recursive" | "retained-mix" = conditionFull.checked
          ? "full-recursive"
          : conditionRetained.checked
            ? "retained-mix"
            : "baseline";

        rareCaption.textContent = `"${rareLabel}" is the rarest category in real life — only ${(probs[rareIndex] * 100).toFixed(1)}% of the time. Watch it closely: the grey tick on each bar shows where it should be; the coloured bar shows where it actually landed that round.`;

        const samples = simulateRun(labels, probs, condition, rounds);
        const roundCounts = samples.map((sample) => counts(labels, sample));

        const round0Pct = (roundCounts[0][rareIndex] / roundSize) * 100;
        const finalCounts = roundCounts[roundCounts.length - 1];
        const finalPct = (finalCounts[rareIndex] / roundSize) * 100;
        writeTakeaway(condition, rareLabel, probs[rareIndex] * 100, round0Pct, finalPct, finalCounts[rareIndex], rounds);

        const truthPct = probs[rareIndex] * 100;
        roundCounts.forEach((cs, r) => {
          const rareCount = cs[rareIndex];
          const pct = (rareCount / roundSize) * 100;
          const row = document.createElement("div");
          row.className = "rs__trend-row";
          const rowLabel = document.createElement("span");
          rowLabel.className = "rs__trend-label";
          rowLabel.textContent = `R${r}`;
          const track = document.createElement("div");
          track.className = "rs__trend-track";
          const fill = document.createElement("div");
          fill.className = "rs__trend-fill";
          fill.style.width = `${Math.min(100, pct).toFixed(1)}%`;
          const truthTick = document.createElement("div");
          truthTick.className = "rs__trend-truth";
          truthTick.style.left = `${Math.min(100, truthPct).toFixed(1)}%`;
          track.append(fill, truthTick);
          row.append(rowLabel, track);
          trendContainer.appendChild(row);

          const li = document.createElement("li");
          li.textContent = `Round ${r}: "${rareLabel}" made up ${rareCount} of ${roundSize} draws (${pct.toFixed(1)}%); its real share is ${truthPct.toFixed(1)}%`;
          trendFallback.appendChild(li);
        });

        labels.forEach((label, i) => {
          const item = document.createElement("li");
          item.className = "rs__legend-item";
          const swatch = document.createElement("span");
          swatch.className = "rs__legend-swatch";
          swatch.style.background = colourFor(i, labels.length);
          item.append(swatch, document.createTextNode(`${label} (true ${(probs[i] * 100).toFixed(1)}%)`));
          legend.appendChild(item);
        });

        roundCounts.forEach((cs, r) => {
          const row = document.createElement("div");
          row.className = "rs__stack-row";
          const rowLabel = document.createElement("span");
          rowLabel.className = "rs__stack-label";
          rowLabel.textContent = `R${r}`;
          const track = document.createElement("div");
          track.className = "rs__stack-track";
          cs.forEach((count, i) => {
            if (count === 0) return;
            const segment = document.createElement("div");
            segment.className = "rs__stack-segment";
            segment.style.width = `${((count / roundSize) * 100).toFixed(2)}%`;
            segment.style.background = colourFor(i, labels.length);
            segment.title = `${labels[i]}: ${count} of ${roundSize} (${((count / roundSize) * 100).toFixed(1)}%)`;
            track.appendChild(segment);
          });
          row.append(rowLabel, track);
          stacks.appendChild(row);
        });

        const headRow = document.createElement("tr");
        const roundHeader = document.createElement("th");
        roundHeader.textContent = "Round";
        headRow.appendChild(roundHeader);
        for (const label of labels) {
          const th = document.createElement("th");
          th.textContent = label;
          headRow.appendChild(th);
        }
        tableHead.appendChild(headRow);

        roundCounts.forEach((cs, r) => {
          const row = document.createElement("tr");
          const roundCell = document.createElement("td");
          roundCell.textContent = `R${r}`;
          row.appendChild(roundCell);
          for (const count of cs) {
            const td = document.createElement("td");
            td.textContent = String(count);
            row.appendChild(td);
          }
          tableBody.appendChild(row);
        });
      }

      categoriesInput.addEventListener("input", render);
      roundsSlider.addEventListener("input", render);
      conditionBaseline.addEventListener("change", render);
      conditionFull.addEventListener("change", render);
      conditionRetained.addEventListener("change", render);
      rerollButton.addEventListener("click", render);

      render();
    }
  }

  document.addEventListener("astro:page-load", initResamplingSimulators);
  initResamplingSimulators();
</script>
