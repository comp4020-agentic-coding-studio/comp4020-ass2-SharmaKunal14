---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const sessions = (await getPublishedCollection("sessions")).sort((a, b) => a.data.week - b.data.week);
const lectures = await getPublishedCollection("lectures");
const assessments = await getPublishedCollection("assessments");

const lectureByWeek = new Map(lectures.map((lecture) => [lecture.data.week, lecture]));

const weeklyChecks = assessments.filter((assessment) => assessment.data.series === "weekly");
const oneOff = assessments.filter((assessment) => assessment.data.series !== "weekly");

// An assessment's `week:` field names the week it is introduced, not the week
// it falls due — several are worked practice for weeks after their own. Place
// each one's due badge on the session whose date is the latest that still
// falls on or before the due date, or the final session if the due date is
// later than the whole course (a post-course due date, e.g. the last piece).
function dueWeekFor(due: Date): number {
  let candidate = sessions[0].data.week;
  for (const session of sessions) {
    if (session.data.date.getTime() <= due.getTime()) {
      candidate = session.data.week;
    }
  }
  return candidate;
}

const dueByWeek = new Map<number, { title: string; id: string; due: Date }[]>();
for (const assessment of oneOff) {
  const week = dueWeekFor(assessment.data.due);
  const list = dueByWeek.get(week) ?? [];
  list.push({ title: assessment.data.title, id: assessment.id, due: assessment.data.due });
  dueByWeek.set(week, list);
}

// Every workshop opens with its own five-minute Generation Check — real,
// week-specific evidence and a question, already written into that week's
// session page under a "Check" heading. Weeks 1–4 titled that heading "The
// five-minute check"; weeks 5–12 retitled it "Check — 5 minutes". Point each
// row at its own week's section instead of the shared assessment overview.
function checkAnchorFor(week: number): { id: string; label: string } {
  return week <= 4
    ? { id: "the-five-minute-check", label: "The five-minute check" }
    : { id: "check--5-minutes", label: "Check — 5 minutes" };
}

// A week's lecture and its workshop always carry the same title (the theme
// the week is built around) — confirmed across all 12 weeks. A table that
// repeats that title in two adjacent columns, every row, is the noise this
// component used to produce. State the title once per week instead, and let
// "Lecture" / "Workshop" / "Check" be short, reusable role labels pointing
// at the three different pages that title actually names.
const rows = sessions.map((session) => ({
  week: session.data.week,
  date: session.data.date,
  session,
  lecture: lectureByWeek.get(session.data.week),
  due: dueByWeek.get(session.data.week) ?? [],
  check: checkAnchorFor(session.data.week),
}));

const weeklyCheckHref =
  weeklyChecks.length > 0 ? withBase(`/assessments/${weeklyChecks[0].id}/`) : null;
---

<p class="timetable-intro">
  Twelve weeks, one Monday lecture and one Wednesday workshop each, plus what is due.
</p>
<ol class="weeks">
  {
    rows.map((row) => (
      <li class="week-card">
        <div class="week-card__when">
          <span class="week-card__week">Week {row.week}</span>
          <span class="week-card__date">{formatCourseDate(row.date)}</span>
        </div>
        <div class="week-card__body">
          <p class="week-card__title">{row.session.data.title}</p>
          <ul class="week-card__roles">
            <li>
              {row.lecture ? (
                <a href={withBase(`/lectures/${row.lecture.id}/`)}>Lecture<span class="visually-hidden"> for week {row.week}</span></a>
              ) : (
                <span class="none">Lecture —</span>
              )}
            </li>
            <li>
              <a href={withBase(`/sessions/${row.session.id}/`)}>Workshop<span class="visually-hidden"> for week {row.week}</span></a>
            </li>
            <li>
              <a href={withBase(`/sessions/${row.session.id}/#${row.check.id}`)} title={row.check.label}>
                Check<span class="visually-hidden"> for week {row.week}</span>
              </a>
            </li>
          </ul>
          {row.due.length > 0 && (
            <ul class="week-card__due">
              {row.due.map((item) => (
                <li>
                  <a href={withBase(`/assessments/${item.id}/`)}>{item.title}</a> due{" "}
                  {formatCourseDate(item.due)}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
{
  weeklyCheckHref && (
    <p class="timetable-footnote">
      Every "Check" link above opens that week's own <a href={weeklyCheckHref}>Generation Check</a>{" "}
      question — the same five-minute exercise, with different evidence each week.
    </p>
  )
}

<style>
  .timetable-intro {
    color: var(--at-text-secondary);
    margin-block-end: 1rem;
  }

  .weeks {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .week-card {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 0.5rem;
    background: var(--at-bg-alt);
  }

  @media (max-width: 30rem) {
    .week-card {
      grid-template-columns: 1fr;
    }
  }

  .week-card__when {
    display: flex;
    flex-direction: column;
    color: var(--at-text);
  }

  .week-card__week {
    font-weight: 700;
  }

  .week-card__date {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .week-card__title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--at-text);
  }

  .week-card__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    padding: 0;
    list-style: none;
  }

  .week-card__roles a,
  .week-card__roles .none {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--at-text);
  }

  .week-card__roles .none {
    color: var(--at-text-secondary);
  }

  .week-card__due {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .week-card__due li + li {
    margin-block-start: 0.25rem;
  }

  .timetable-footnote {
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }
</style>
